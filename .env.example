# Copy this file to ".env" (same folder) and put your real MySQL password there.
# .env is git-ignored, so the password never gets committed.
#
# Local MySQL:
DB_URL=jdbc:mysql://localhost:3306/food_wastage?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
#
# Production (Render / Railway): set these as hosting environment variables, not in git.
# DB_URL=jdbc:mysql://HOST:3306/food_wastage?sslMode=REQUIRED&serverTimezone=UTC
# DB_USERNAME=...
# DB_PASSWORD=...
# CORS_ORIGINS=https://your-frontend.vercel.app
# CORS_ORIGIN_PATTERNS=https://*.vercel.app
# PORT is assigned by the host; do not hardcode it.
